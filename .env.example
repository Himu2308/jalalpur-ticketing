# Copy this file to .env and fill in your real values. Never commit .env.

PORT=3000

# From Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Made-up secret key YOU choose — the admin dashboard uses this to authenticate.
ADMIN_KEY=change-me-admin-secret

# One key PER RIDE. Whichever key a staff device signs in with, that device
# can ONLY validate tickets for that ride — enforced by the server. Give
# each ride's operator only their own key. Ride ids must match rides.js.
STAFF_KEY_GOKART=gokart@1
STAFF_KEY_ROCKET=rocket@1
STAFF_KEY_ZIPLINE=zipline@1
STAFF_KEY_COMMANDO=commando@1
STAFF_KEY_CYCLE360=360cycle@1
STAFF_KEY_GYRO=gyro@1
STAFF_KEY_SKYROLLER=roller@1

# Where the SQLite database file is stored
DB_PATH=./tickets.db

# Set to "true" to skip real Razorpay payments entirely — booking a ride
# instantly generates a ticket with no money moving. Only for testing/demos.
# Leave unset or "false" for real payments.
DEMO_MODE=false
